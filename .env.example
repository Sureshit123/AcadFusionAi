# AcadFusion AI – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# Flask session secret key (generate a long random string)
FLASK_SECRET_KEY=your-very-long-random-secret-key-here

# Super Admin credentials (env-based fallback login – optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# VTU Scraper mode: true = Demo/Mock data, false = Live VTU site
VTU_MOCK_MODE=true

# Admin email – this account gets admin role automatically on first login
ADMIN_EMAIL=sharmasreshit@gmail.com
