# AcadFusion AI – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# MongoDB connection string (Atlas or local) - Project 2 uses separate database 'acadfusion_ai'
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/acadfusion_ai?retryWrites=true&w=majority

# Optional: Override database name if not specified in MONGODB_URI (defaults to acadfusion_ai)
# MONGODB_DB_NAME=acadfusion_ai

# Backward-compatible fallback (used only if MONGODB_URI is absent)
# MONGO_URI=mongodb://127.0.0.1:27017/acadfusion_ai

# Flask session secret key (generate a long random string)
FLASK_SECRET_KEY=your-very-long-random-secret-key-here

# Super Admin credentials (env-based fallback login – optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# VTU Scraper mode: true = Demo/Mock data, false = Live VTU site
VTU_MOCK_MODE=true

# Admin email – this creator account is granted admin privileges automatically
ADMIN_EMAIL=sharmasreshit@gmail.com
